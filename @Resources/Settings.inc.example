; ============================================================
;  LIQUID GLASS - Home Assistant widget settings
;  Edit the values below to match your setup
; ============================================================

; --- Home Assistant connection ---
; Create a long-lived access token: HA > Profile > Create Token
HA_SERVER=YOUR_HA_SERVER
HA_TOKEN=YOUR_HA_TOKEN_HERE
HA_SSL=false
HA_PORT=8123

; --- Entities (find exact IDs in HA: Settings > Devices & Services,
;     or browse http://<server>:8123/developer-tools/state) ---
WEATHER_ENTITY=YOUR_ENTITY_ID
CLIMATE_ENTITY=YOUR_ENTITY_ID
LIGHT_ENTITY=YOUR_ENTITY_ID
PRESENCE_ENTITY=YOUR_ENTITY_ID
SENSOR_ENTITY=YOUR_ENTITY_ID

; --- Labels shown on the widget ---
LOCATION_LABEL=Home
LIGHT_LABEL=LIGHTSTRIP
PRESENCE_LABEL=YOUR_PRESENCE_LABEL
SENSOR_LABEL=YOUR_SENSOR_LABEL

; --- Units (match your HA unit system) ---
UNIT_TEMP=°F
UNIT_WIND=mph
UNIT_PRESS=inHg
UNIT_SENSOR=AQI

; --- Sensor bar scale (AQI: 300 standard / 500 US EPA) ---
SENSOR_MAX=300
PLUGIN_PATH=YOUR_PLUGIN_PATH

; --- All HA entities ---
ENTITY_BINARY_SENSOR_IPAD_KIOSK_MODE=YOUR_ENTITY_ID
ENTITY_BINARY_SENSOR_IPAD_KIOSK_SCREENSAVER=YOUR_ENTITY_ID
